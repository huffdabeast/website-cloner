    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink block with a mono label and an 8px square; a blue panel slides in from the left on hover and the square rotates.",
      "html": "<a href=\"#\" class=\"ds-btn-primary\"><span class=\"ds-btn-primary__panel\"></span><span class=\"ds-btn-primary__sq\"></span><span class=\"ds-btn-primary__label\">Meet SKY-001</span></a>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;height:52px;padding:0 20px;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:15px;font-weight:600;letter-spacing:-0.02em;text-transform:uppercase;white-space:nowrap;text-decoration:none;border:0;border-radius:0;cursor:pointer;position:relative;overflow:hidden;min-width:220px;background:#1a1a1a;color:#fff;transition:color .3s,scale .3s}.ds-btn-primary__panel{position:absolute;inset:0;background:#3e57da;transform:translateX(-100%);transition:transform .3s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover .ds-btn-primary__panel,.ds-btn-primary:focus-visible .ds-btn-primary__panel{transform:translateX(0)}.ds-btn-primary__sq{position:relative;order:2;width:8px;height:8px;background:#fff;transition:rotate .3s}.ds-btn-primary:hover .ds-btn-primary__sq{rotate:-180deg}.ds-btn-primary__label{position:relative;order:1}.ds-btn-primary:active{scale:.98}.ds-btn-primary:focus-visible{outline:2px solid #3e57da;outline-offset:2px}"
    },
    {
      "name": "Line Button",
      "kind": "button",
      "refersTo": "button-line",
      "description": "Underlined mono label with a north-east arrow; rule and text turn blue on hover.",
      "html": "<a href=\"#\" class=\"ds-btn-line\"><span>Watch the launch</span><span aria-hidden=\"true\" class=\"ds-btn-line__arrow\">↗</span></a>",
      "css": ".ds-btn-line{display:inline-flex;align-items:center;justify-content:space-between;gap:32px;height:52px;padding:0 20px;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:15px;font-weight:600;letter-spacing:-0.02em;text-transform:uppercase;white-space:nowrap;text-decoration:none;border:0;border-radius:0;cursor:pointer;position:relative;overflow:hidden;padding:0 4px;background:transparent;color:#1a1a1a;border-bottom:1px solid #1a1a1a;overflow:visible;transition:color .3s,border-color .3s}.ds-btn-line:hover,.ds-btn-line:focus-visible{color:#3e57da;border-color:#3e57da}.ds-btn-line__arrow{display:inline-block;transition:transform .3s}.ds-btn-line:hover .ds-btn-line__arrow{transform:translate(2px,-2px)}.ds-btn-line:focus-visible{outline:2px solid #3e57da;outline-offset:2px}"
