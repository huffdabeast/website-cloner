    {
      "name": "Post Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Hairline-grid cell with a 16:10 image, mono meta row, 22px title, excerpt and a dashed footer; a blue outline fades in on hover.",
      "html": "<a href=\"#\" class=\"ds-card\"><span class=\"ds-card__outline\"></span><span class=\"ds-card__thumb\"></span><span class=\"ds-card__body\"><span class=\"ds-card__meta\"><span class=\"ds-card__blue\">6 min read</span><span class=\"ds-card__dot\"></span><span>Skyfall Research</span></span><span class=\"ds-card__title\">LLMs Are Not Continual Learners</span><span class=\"ds-card__excerpt\">Enterprise AI is moving from static tools to autonomous agents that must keep performing as conditions change.</span><span class=\"ds-card__foot\"><span>Mar 18, 2026</span><span class=\"ds-card__read\">Read →</span></span></span></a>",
      "css": ".ds-card{position:relative;display:flex;flex-direction:column;width:360px;background:#fff;border:1px solid #e0e0e0;color:#1a1a1a;text-decoration:none;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-card__outline{position:absolute;inset:-1px;border:1px solid #3e57da;opacity:0;transition:opacity .3s;pointer-events:none}.ds-card:hover .ds-card__outline,.ds-card:focus-visible .ds-card__outline{opacity:1}.ds-card__thumb{display:block;aspect-ratio:16/10;background:#f6f6f6 repeating-linear-gradient(45deg,#e0e0e0 0 1px,transparent 1px 12px);border-bottom:1px solid #e0e0e0}.ds-card__body{display:flex;flex-direction:column;gap:12px;padding:20px}.ds-card__meta,.ds-card__foot{display:flex;align-items:center;gap:14px;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:500;letter-spacing:-0.02em;text-transform:uppercase;color:#7a7a7a}.ds-card__blue{color:#3e57da}.ds-card__dot{width:4px;height:4px;background:#adadad}.ds-card__title{font-size:22px;line-height:1.15;font-weight:500;letter-spacing:-0.05em;transition:color .3s}.ds-card:hover .ds-card__title{color:#3e57da}.ds-card__excerpt{font-size:15px;line-height:1.5;color:#474747}.ds-card__foot{justify-content:space-between;margin-top:auto;padding-top:14px;border-top:1px dashed #e0e0e0}.ds-card__read{color:#1a1a1a;transition:color .3s}.ds-card:hover .ds-card__read{color:#3e57da}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "48px square field with a 25% ink border; blue border and 1px ring on focus, red on error.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field__label\">Work email<span class=\"ds-field__req\">*</span></span><input class=\"ds-input\" type=\"email\" placeholder=\"you@company.com\"></label>",
      "css": ".ds-field{display:block;width:320px;font-family:Geist,ui-sans-serif,system-ui,sans-serif;color:#1a1a1a}.ds-field__label{display:flex;font-size:15px;font-weight:500;letter-spacing:-0.02em}.ds-field__req{color:#3e57da;margin-left:2px}.ds-input{display:block;width:100%;height:48px;margin-top:8px;padding:0 14px;background:#fff;border:1px solid rgb(26 26 26 / .25);border-radius:0;font:inherit;font-size:16px;letter-spacing:-0.02em;color:#1a1a1a;outline:none;transition:border-color .2s,box-shadow .2s}.ds-input::placeholder{color:rgb(26 26 26 / .35)}.ds-input:hover{border-color:rgb(26 26 26 / .5)}.ds-input:focus{border-color:#3e57da;box-shadow:0 0 0 1px #3e57da}.ds-input[aria-invalid=true]{border-color:#c2362f}"
    },
    {
      "name": "Panel",
      "kind": "custom",
      "refersTo": "panel-title-bar",
      "description": "Ink-bordered container with a 24px mono title bar; shown here holding a benchmark bar chart.",
      "html": "<div class=\"ds-panel\"><div class=\"ds-panel__bar\"><span>IoU ↑</span><span class=\"ds-panel__tag\">BIM</span></div><div class=\"ds-panel__body\"><div class=\"ds-row ds-row--ours\"><span>SKY-001</span><span class=\"ds-bar\"><span style=\"width:27%\"></span></span><span class=\"ds-val\">27.2%</span></div><div class=\"ds-row\"><span>GPT-6 Astra</span><span class=\"ds-bar ds-bar--grey\"><span style=\"width:20%\"></span></span><span class=\"ds-val\">20.4%</span></div><div class=\"ds-row\"><span>Claude Opus 5.5</span><span class=\"ds-bar ds-bar--grey\"><span style=\"width:12%\"></span></span><span class=\"ds-val\">12.1%</span></div></div></div>",
      "css": ".ds-panel{width:340px;border:1px solid #1a1a1a;background:#fff;color:#1a1a1a;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-panel__bar{display:flex;justify-content:space-between;align-items:center;min-height:24px;padding:0 6px;background:#1a1a1a;color:#fff;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-weight:500;letter-spacing:.02em}.ds-panel__tag{color:rgb(255 255 255 / .7)}.ds-panel__body{border-top:1px solid #1a1a1a;padding:12px}.ds-row{display:grid;grid-template-columns:minmax(0,7.5rem) 1fr 4.5rem;align-items:center;gap:8px;min-height:32px;border-bottom:1px solid #e0e0e0;font-size:13px;letter-spacing:-0.02em}.ds-row--ours{margin:0 -12px;padding:0 12px;background:#eef1fd;color:#3e57da;font-weight:500}.ds-bar{position:relative;height:10px;display:block}.ds-bar>span{position:absolute;inset:0 auto 0 0;background:#3e57da}.ds-bar--grey>span{background:#c4c4c4}.ds-val{text-align:right;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "FAQ Row",
      "kind": "custom",
      "refersTo": "faq-icon",
      "description": "Native details on the ink ground; the plus square turns blue and rotates 45 degrees when open.",
      "html": "<div class=\"ds-faq\"><details class=\"ds-faq__item\"><summary class=\"ds-faq__q\"><span>What is a world model?</span><span class=\"ds-faq__icon\"><svg viewBox=\"0 0 12 12\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M6 1v10M1 6h10\"/></svg></span></summary><p class=\"ds-faq__a\">A model that predicts how a system evolves so an agent can plan against it instead of guessing.</p></details></div>",
      "css": ".ds-faq{width:420px;padding:24px;background:#1a1a1a;color:#fff;font-family:Geist,ui-sans-serif,system-ui,sans-serif}.ds-faq__item{border-top:1px solid #474747;border-bottom:1px solid #474747}.ds-faq__q{display:flex;align-items:center;gap:16px;min-height:56px;padding:12px 0;list-style:none;cursor:pointer;font-family:'Geist Mono',ui-monospace,SFMono-Regular,Menlo,monospace;font-size:13px;letter-spacing:.03em;transition:color .3s}.ds-faq__q::-webkit-details-marker{display:none}.ds-faq__q>span:first-child{flex:1}.ds-faq__item[open] .ds-faq__q{color:#6f83f0}.ds-faq__icon{display:grid;place-items:center;width:32px;height:32px;background:#fff;color:#1a1a1a;transition:background .3s,color .3s}.ds-faq__icon svg{transition:transform .3s}.ds-faq__item[open] .ds-faq__icon{background:#3e57da;color:#fff}.ds-faq__item[open] .ds-faq__icon svg{transform:rotate(45deg)}.ds-faq__a{margin:0;padding:0 0 20px;max-width:60ch;font-size:17px;line-height:1.25;letter-spacing:-0.02em;color:rgb(255 255 255 / .85)}"
